(defun main ()
  (declare rtype int)

  (srand (time NULL))

  (with-sdl2-init (SDL_INIT_VIDEO)
    (with-sdl2-window
      (window "Wallbreaker"
              SDL_WINDOWPOS_CENTERED SDL_WINDOWPOS_CENTERED
              WIDTH HEIGHT
              SDL_WINDOW_SHOWN)
      (with-sdl2-renderer
        (renderer window -1 SDL_RENDERER_ACCELERATED)
        (game_loop renderer)
        (return EXIT_SUCCESS)))))
