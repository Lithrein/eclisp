(import "simple")

(%:define WIDTH  640)
(%:define HEIGHT 480)

(macro progn (&body rest)
  "Use statement-expressions to emulate the behavior of PROGN."
 `(prog* #{(\{} ,@rest #{\})}))

(macro min (a b)
  "Evalutate to MIN(a, b)."
  `(progn
     (def _a (type-of ,a) ,a)
     (def _b (type-of ,b) ,b)
     (?: (< _a _b) _a _b)))

(macro max (a b)
  "Evalutate to MAX(a, b)."
  `(progn
     (def _a (type-of ,a) ,a)
     (def _b (type-of ,b) ,b)
     (?: (> _a _b) _a _b)))

