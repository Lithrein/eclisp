(macro defmacro (&rest rest)
  `(macro ,@rest))

(defmacro caar (list-caar)   `(car (car ,list-caar)))
(defmacro cadr (list-cadr)   `(car (cdr ,list-cadr)))
(defmacro cdar (list-cadr)   `(cdr (car ,list-cdar)))
(defmacro cddr (list-cddr)   `(cdr (cdr ,list-cddr)))

(defmacro caaar (list-caaar) `(car (car (car ,list-caaar))))
(defmacro caadr (list-caadr) `(car (car (cdr ,list-caadr))))
(defmacro cadar (list-cadar) `(car (cdr (car ,list-cadar))))
(defmacro caddr (list-caddr) `(car (cdr (cdr ,list-caddr))))
(defmacro cdaar (list-cdaar) `(cdr (car (car ,list-cdaar))))
(defmacro cdadr (list-cdadr) `(cdr (car (cdr ,list-cdadr))))
(defmacro cddar (list-cddar) `(cdr (cdr (car ,list-cddar))))
(defmacro cdddr (list-cdddr) `(cdr (cdr (cdr ,list-cdddr))))

(defmacro metafn (name args &rest rest)
  "Define a meta layer function."
  (if (stringp (car rest))
    `(meta (def ,name (lambda ,name ,args ,@(cdr rest)) ,(car rest)))
    `(meta (def ,name (lambda ,name ,args ,@rest)))))

(defmacro not (a) (! a))
(defmacro ior (&rest or-rest)  `(|| ,@or-rest))
(defmacro and (&rest and-rest) `(&& ,@and-rest))

(defmacro lior (&rest lior-rest) `(| ,@lior-rest))
(defmacro leor (&rest leor-rest) `(^ ,@leor-rest))
(defmacro land (&rest land-rest) `(& ,@land-rest))

;; todo: rewrite as a counted loop
;; todo: rename to exactly-one
;; todo: provide at-most-one
;; todo: provide at-leat-one
(defmacro eor (&rest eor-rest)
  (if eor-rest
    (if (== 1 (length eor-rest))
        `,(car eor-rest)
    (if (== 2 (length eor-rest))
        `(ior (and (not ,(car eor-rest)) ,(cadr eor-rest))
              (and ,(car eor-rest) (not ,(cadr eor-rest))))
        `(ior (and ,(car eor-rest) (not (ior ,@(cdr eor-rest))))
              (and (not ,(car eor-rest)) (eor ,@(cdr eor-rest))))))))

(defmacro cond (fst &body body)
  (if body
      (if (&& (listp (car body)) (ior (== (caar body) 't)
                                      (== (caar body) 'else)
                                      (== (caar body) 'otherwise)))
          `(if ,(car fst) (prog ,@(cdr fst))
             (prog ,@(cdr (car body))))
        `(if ,(car fst) (prog ,@(cdr fst))
           (cond ,@body)))
    `(if ,(car fst) (prog ,@(cdr fst)))))

(metafn member (elem list)
  (if list
      (if (== elem (car list))
          elem
          (member elem (cdr list)))))

(metafn member-if (pred list)
  (if list
    (if (funcall pred (car list))
      (car list)
      (member-if pred (cdr list)))))

(metafn symbol-get (sym prop env)
  (if env
    (if (member sym (scope-symbols env))
        (scope-symbol-get sym prop env)
        (symbol-get sym prop (cdr env)))))

(metafn symbol-set (sym prop val env)
  (if env
    (if (member sym (scope-symbols env))
        (scope-symbol-set sym prop val env)
        (symbol-set sym prop val (cdr env)))))

(metafn my-type-of-aux (expr env)
  (if (consp expr)
      (cond
        ((== '& (car expr))
          `(ptr ,(my-type-of-aux (cadr expr))))
        ((== '* (car expr))
          (let ((stype (my-type-of-aux (cadr expr) env)))
            (if (== 'ptr (car stype))
                (cadr stype)
                (error "Invalid use of `*'."))))
        ((== 'cast (car expr)) (cadr expr))
        ((== 'aref (car expr))
          (let ((stype (my-type-of-aux (cadr expr) env))
                (len (length stype)))
            (cond
              ((&& (== 'array (car stype)) (== 3 len))
			   (caddr stype))
              ((&& (== 'array (car stype)) (== 2 len))
			   (cadr stype))
              (t (error "Invalid use of `aref'.")))))
        ((== '. (car expr))
          (let ((stype (my-type-of-aux (cadr expr) env)))
            (if (== 'struct (car stype))
				(cadr (member-if (lambda (x) (== (car x) (caddr expr)))
								 (cddr stype)))
                (error "Invalid use of `.'."))))
        ((== '-> (car expr))
          (let ((stype (my-type-of-aux (cadr expr) env)))
            (if (&& (== 'ptr (car stype) (== 'struct (caadr stype))))
				(cadr (member-if (lambda (x) (== (car x) (caddr expr)))
								 (cddr (cadr stype))))
                (error "Invalid use of `->'."))))
        (t
          (let ((stype (my-type-of-aux (car expr) env)))
            (if (== '-> (car stype))
                (cadr stype)
                (error "can't determine return type.")))))
      (symbol-get expr 'type env)))

(defmacro my-type-of (sym &env env)
  (my-type-of-aux sym env))

(metafn current-function-aux (env)
  (if env
    (if (== (car (scope-type env)) 'function)
        (cdr (scope-type env))
        (current-function-aux (cdr env)))))

(defmacro current-function (&env env)
  (current-function-aux env))

(metafn current-return-type-aux (env)
  (if env
    (if (== (car (scope-type env)) 'function)
        (cadr (scope-symbol-get (cdr (scope-type env)) 'type (cdr env)))
        (current-return-type-aux (cdr env)))))

(metafn symbol-under-definition (env)
  (if env
    (if (== (car (scope-type env)) 'def)
        (cdr (scope-type env))
        (symbol-under-definition (cdr env)))))

(defmacro current-return-type (&env env)
  (current-return-type-aux env))

(metafn expand-place (place type)
   (if place
     (if (== 1 (length place))
       (car place)
       (cond
         ((== 'array (car type))
          (cond ((== 3 (length type))
               (expand-place `((aref ,(car place) ,(cadr place)) ,@(cddr place))
                     (caddr type)))
              ((== 2 (length type))
               (expand-place `((aref ,(car place) ,(cadr place)) ,@(cddr place))
                     (cadr type)))
              (t (error "array expect 2 or 3 arguments."))))
         ((member (car type) '(struct union))
          (expand-place `((. ,(car place) ,(cadr place)) ,@(cddr place))
                         (cadr (member-if (lambda (x) (== (car x) (cadr place)))
                                          (cddr type)))))
         ((&& (== 'ptr (car type)) (== 'struct (caadr type)))
          (expand-place `((-> ,(car place) ,(cadr place)) ,@(cddr place))
                         (cadr (member-if (lambda (x) (== (car x) (cadr place)))
                                          (cddr (cadr type))))))
         ((== 'ptr (car type))
          (expand-place `((aref ,(car place) ,(cadr place)) ,@(cddr place))
                         (cadr type)))))))

(defmacro @ (&rest place &env env)
  (let ((xplace (macroexpand (car place) env)))
    (expand-place place (my-type-of-aux xplace env))))

(metafn assoc (key list)
  (if list
    (if (== (caar list) key)
        (car list)
        (assoc key (cdr list)))))

(metafn build-type-aux (typ list)
  (if typ
    `(,(assoc (car typ) list) ,@(build-type-aux (cdr typ) list))))

(metafn build-type (typ list)
  (if (car typ)
      `(-> ,(cadr (assoc '__rtype list)) ,@(build-type-aux typ list))
      `(-> ,(cadr (assoc '__rtype list)) void)))

(metafn process-type-decls (type &rest vars)
  (if vars
      `((,(car vars) ,type) ,@(process-type-decls type (cdr vars)))))

(metafn extract-declare-forms-aux (typ-decls fn-attrs misc-attrs &rest rest)
  (if (== (caar rest) 'declare)
      (destructuring-bind (declare category type &rest vars) (car rest)
        (cond
          ((== category 'type)      (extract-declare-forms-aux `(,@(process-type-decls type vars) ,@typ-decls) fn-attrs misc-attrs (cdr rest)))
          ((== category 'rtype)     (extract-declare-forms-aux `((__rtype ,type) ,@typ-decls) fn-attrs misc-attrs (cdr rest)))
          ((== category 'inline)    (extract-declare-forms-aux typ-decls `(:inline ,type ,@fn-attrs) misc-attrs (cdr rest)))
          ((== category 'static)    (extract-declare-forms-aux typ-decls `(:linkage static ,@fn-attrs) misc-attrs (cdr rest)))
          ((== category 'noreturn)  (extract-declare-forms-aux typ-decls `(:noreturn ,@fn-attrs) misc-attrs (cdr rest)))
          ((== category 'interrupt) (extract-declare-forms-aux typ-decls `(:interrupt ,@fn-attrs) misc-attrs (cdr rest)))
          ((== category 'scope)     (extract-declare-forms-aux typ-decls fn-attrs `((:scope ,type) ,@misc-attrs) (cdr rest)))))
    `(,typ-decls ,fn-attrs ,misc-attrs ,rest)))

(metafn extract-declare-forms (&rest body)
  (extract-declare-forms-aux nil nil nil body))

(metafn extract-params (&rest rest)
  "Extract function parameters from a function type."
  (if rest
    (if (== '&key (car rest))
      `(,@(extract-params (cdr rest)))
       (if (symbolp (car rest))
         `(,(car rest) ,@(extract-params (cdr rest)))
         (if (listp (car rest))
           `(,(caar rest) ,@(extract-params (cdr rest))))))))

(defmacro defun (fn-name sig &body body)
  (let ((docp (stringp (car body)))
        (decl-attrs-body (extract-declare-forms (if docp (cdr body) body)))
        (params (extract-params sig)))
       (destructuring-bind (tmp-sig fn-attrs misc-attrs nbody) decl-attrs-body
         (let ((nsig (build-type params tmp-sig))
               (scope_ (cadr (assoc ':scope misc-attrs)))
               (scope (if scope_ scope_ 'global)))
           (if (== scope 'global)
             `(prog*
                (macro ,fn-name ,sig (list '%funcall ',fn-name ,@params))
                (%:if ((defined PROCESS_HEADER)
                        ,(if docp `(def (,fn-name ,@fn-attrs) ,nsig ,(car body))
                                  `(def (,fn-name ,@fn-attrs) ,nsig)))
                      (t (def (,fn-name ,@fn-attrs) ,nsig
                        ,(if docp (car body)) ,@nbody))))
             `(prog*
                (macro ,fn-name ,sig (list '%funcall ',fn-name ,@params))
                (%:if ((! (defined PROCESS_HEADER))
                        (def (,fn-name ,@fn-attrs) ,nsig
                        ,(if docp (car body)) ,@nbody)))))))))

;; deprecated
(macro local-defun (fn-name typ &body body)
  `(%:if ((! (defined PROCESS_HEADER)) (def ,fn-name ,typ ,@body))))

(macro local-asm (&body body)
  `(%:if ((! (defined PROCESS_HEADER)) (asm ,@body))))

(macro local-defvar (var-name typ &body body)
  `(%:if ((! (defined PROCESS_HEADER)) (def (,var-name :linkage static) ,typ ,@body))))

;; deprecated
(macro definline (fn-name typ &body body)
  (if (listp fn-name)
    `(%:if ((defined PROCESS_HEADER) (def (,@fn-name :inline always) ,typ ,@body)))
    `(%:if ((defined PROCESS_HEADER) (def (,fn-name :inline always) ,typ ,@body)))))

(defmacro deftype (type definition)
  `(def ,type (typedef ,definition)))

(defmacro defenum-internal (name (&rest values) &rest documentation)
  (if documentation
      `(def (enum ,name ,@values) ,(car documentation))
      `(def (enum ,name ,@values))))

(defmacro global-defenum (name (&rest values) &rest documentation)
  `(%:if ((defined PROCESS_HEADER) (defenum-internal ,name (,@values) ,@documentation))))

(defmacro local-defenum (name (&rest values) &rest documentation)
  `(%:if ((! (defined PROCESS_HEADER)) (defenum-internal ,name (,@values) ,@documentation))))

(defmacro defenum (name &rest body)
  (let ((decl-attrs-body (extract-declare-forms body)))
    (destructuring-bind (_ _ misc-attrs
                           ((&rest values) &rest documentation)) decl-attrs-body
      (let ((scope (cadr (assoc ':scope misc-attrs))))
        (if scope
            (if (== scope 'local)
                `(local-defenum ,name (,@values) ,@documentation)
                `(global-defenum ,name (,@values) ,@documentation))
            `(global-defenum ,name (,@values) ,@documentation))))))

(defmacro define-struct-or-union-internal (sou name (&rest fields) &rest documentation)
  (if documentation
      (if (listp name)
          `(def ,(cdr name) (,sou ,(car name) ,@fields) ,(car documentation))
          `(def (,sou ,name ,@fields) ,(car documentation)))
      (if (listp name)
          `(def ,(cdr name) (,sou ,(car name) ,@fields))
          `(def (,sou ,name ,@fields)))))

(defmacro local-define-struct-or-union (sou name (&rest fields) &rest documentation)
  `(%:if ((! (defined PROCESS_HEADER))
          (define-struct-or-union-internal ,sou ,name (,@fields) ,@documentation))))

(defmacro global-define-struct-or-union (sou name (&rest fields) &rest documentation)
  `(%:if ((defined PROCESS_HEADER)
          (define-struct-or-union-internal ,sou ,name (,@fields) ,@documentation))))

(defmacro define-struct-or-union (sou name &rest body)
  (let ((decl-attrs-body (extract-declare-forms body)))
    (destructuring-bind (type-decls fn-decls misc-attrs
                         ((&rest fields) &rest documentation)) decl-attrs-body
      (let ((scope (cadr (assoc ':scope misc-attrs))))
        (if scope
          (if (== scope 'local)
            `(local-define-struct-or-union ,sou ,name (,@fields) ,@documentation)
             (if (== scope 'global)
               `(global-define-struct-or-union ,sou ,name (,@fields) ,@documentation)))
          `(global-define-struct-or-union ,sou ,name (,@fields) ,@documentation))))))

(defmacro defstruct (name &rest body)
  `(define-struct-or-union struct ,name ,@body))

(defmacro defunion (name &rest body)
  `(define-struct-or-union union ,name ,@body))

(defmacro local-deftype (type definition)
  `(%:if ((! (defined PROCESS_HEADER)) (deftype ,type ,definition))))

(defmacro global-deftype (type definition)
  `(%:if ((defined PROCESS_HEADER) (deftype ,type ,definition))))

(defmacro defcast (name type val)
  "Performs a cast to the proper type at definition time.
When dealing with void pointers, we often see the following pattern:

                (def name type ((cast type) ...))

This macro allows to not have to type `type' twice especially when
its a long structure name. "
  `(def ,name ,type (cast ,type ,val)))

(metafn multiline-string-aux (&rest strings)
  (if strings
      (concat (car strings)
              (multiline-string-aux (cdr strings)))
    ""))

(defmacro multiline-string (&rest strings)
  `,(multiline-string-aux strings))

(defmacro import (&rest files)
  (if files
    `(prog
        (%:include (,(concat (car files) ".eclisp") ,(concat (car files) ".h")))
        (import ,@(cdr files)))))

(defmacro when (condition &body body)
  `(if ,condition
    (prog
      ,@body)))

(defmacro unless (condition &body body)
  `(if (! ,condition)
     (prog
       ,@body)))

(defmacro until (condition &body body)
  `(while (! ,condition)
     (prog
       ,@body)))

(defmacro awhen (condition &body body)
  `(prog
     (def it int ,condition)
     (when it ,@body)))

(defmacro aif (condition then else)
  `(prog
     (def it int ,condition)
     (if ,it ,then ,else)))

(defmacro loop (&body body)
  `(while 1 ,@body))

(defmacro unwind-protect (form &body cleanup-forms)
  (let ((cleanup (gensym "cleanup"))
        (result  (gensym "result"))
        (returnp (gensym "returnp")))
    `(prog
       (def ,result int)
       (def ,returnp int 0)
       (macrolet ((return (expr)
                      `(prog
                        (= ,',returnp 1)
                        (= ,',result ,expr)
                        (goto ,',cleanup))))
        ,form)
        (label ,cleanup)
        ,@cleanup-forms
       (if ,returnp (return ,result)))))

(defmacro with-open-file ((var filename mode) &body body)
  `(prog
    (def ,var (ptr FILE) NULL)
    (unwind-protect
     (prog
        (= ,var (fopen ,filename ,mode))
        (unless ,var (return -1))
        ,@body)
      (if ,var
        (fclose ,var)))))

(defmacro with-sdl2-init (args &body body)
  `(unwind-protect
     (prog
       (when (SDL_Init ,@args)
         (fprintf stderr "Error SDL_Init: %s" (SDL_GetError))
         (return EXIT_FAILURE))
      ,@body)
     (SDL_Quit)))

(defmacro with-sdl2-window ((window wtitle x y w h flags) &body body)
  `(prog
      (def ,window (ptr SDL_Window)
           (SDL_CreateWindow ,wtitle ,x ,y ,w ,h ,flags))
      (unwind-protect
        (prog
          (unless ,window
            (fprintf stderr "Error SDL_CreateWindow: %s" (SDL_GetError))
            (return EXIT_FAILURE))
         ,@body)
      (SDL_DestroyWindow ,window))))

(defmacro with-sdl2-renderer ((renderer window index flags) &body body)
  `(prog
      (def ,renderer (ptr SDL_Renderer)
           (SDL_CreateRenderer ,window ,index ,flags))
      (unwind-protect
        (prog
           (unless ,renderer
             (fprintf stderr "Error SDL_CreateRenderer: %s" (SDL_GetError))
             (return EXIT_FAILURE))
         ,@body)
      (SDL_DestroyRenderer ,renderer))))

(defmacro ~> (fst snd &body rst)
  (let ((snd (if (listp snd) snd (list snd))))
    (if (null rst)
        `(,(car snd) ,fst ,@(cdr snd))
        `(~> (,(car snd) ,fst ,@(cdr snd)) ,@rst))))

(defmacro ~>> (fst snd &body rst)
  (let ((snd (if (listp snd) snd (list snd))))
    (if (null rst)
        `(,(car snd) ,@(cdr snd) ,fst)
        `(~>> (,(car snd) ,@(cdr snd) ,fst) ,@rst))))
